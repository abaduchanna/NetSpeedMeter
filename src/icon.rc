1 ICON "icon.ico"

// Version-resource constants are normally pulled from winver.h; define them
// inline so the .rc compiles with any rc.exe regardless of INCLUDE paths.
#ifndef VOS_NT_WINDOWS32
#define VOS_NT_WINDOWS32 0x00040004L
#endif
#ifndef VFT_APP
#define VFT_APP 0x00000001L
#endif

1 VERSIONINFO
FILEVERSION     2,5,0,0
PRODUCTVERSION  2,5,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "3S Verse"
      VALUE "FileDescription",  "NetSpeedMeter - taskbar network speed display"
      VALUE "FileVersion",      "2.6.0"
      VALUE "InternalName",     "NetSpeedMonitor"
      VALUE "OriginalFilename", "NetSpeedMonitor.exe"
      VALUE "ProductName",      "NetSpeedMeter"
      VALUE "ProductVersion",   "2.6.0"
      VALUE "LegalCopyright",   "MIT License - 3S Verse"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
